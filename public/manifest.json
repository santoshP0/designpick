{
  "manifest_version": 3,
  "name": "DesignPick",
  "version": "1.0.0",
  "description": "Extract design tokens from any webpage — CSS variables, colors, fonts, radii, and shadows. Export as CSS, JSON, or Figma Tokens.",
  "minimum_chrome_version": "88",
  "homepage_url": "https://github.com/santoshP0/designpick",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DesignPick — Extract design tokens",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
